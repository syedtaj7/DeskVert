<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": Tapshift.exe, uploaded by the release workflow before packaging. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Tapshift.exe" product-name="Tapshift" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
