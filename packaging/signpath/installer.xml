<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": Deskvert-Setup-<version>.exe, made from the signed app. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Deskvert" product-version="${version}">
      <include path="Deskvert-Setup-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
